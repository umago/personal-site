<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">

        <link rel="stylesheet" type="text/css" href="/style.css">
        {% if title %}
            <title>{{ title }}</title>
        {% endif %}
    </head>

    <body>
	<div class="wrapper">
	    <div class="header">
		<h1>{{ header }}</h1>
		<ul>
		    {% for name, href in __links__ %}
		        <li><a href="{{ href }}">{{ name }}</a></li>
		    {% endfor %}
		</ul>
	    </div>
	    {% if __posts__ %}
		<div class="posts">
                    <ul>
                        {% for post in __posts__ %}
                            <li>{{ post.date.strftime('%d %B, %Y') }} - <a href="{{ post.__href__ }}">{{ post.title }}</a>
                                <p class="post_headline">{{ post.headline }}</p>
                                {% if post.tags %}
                                    <p class="post_tags">{% for tag in post.tags %}<a href="/tags/{{ tag }}/" class="tag">#{{ tag }}</a> {% endfor %}</p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
		</div>
                {% if __total_pages__ is defined and __total_pages__ > 1 %}
                    <div class="pagination">
                        {% if __has_prev__ %}
                            <a href="{{ __prev_url__ }}">&larr; newer</a>
                        {% else %}
                            <span class="pagination-disabled">&larr; newer</span>
                        {% endif %}
                        <span class="pagination-info">page {{ __current_page__ }} of {{ __total_pages__ }}</span>
                        {% if __has_next__ %}
                            <a href="{{ __next_url__ }}">older &rarr;</a>
                        {% else %}
                            <span class="pagination-disabled">older &rarr;</span>
                        {% endif %}
                    </div>
                {% endif %}
	    {% endif %}

	    {% if __content__ %}
                {% if __post_title__ %}
                    <h1 class="post_title">{{ __post_title__ }}</h1>
                    <p class="post_date">{{ __post_date__.strftime('%d %B, %Y') }}</p>
	        {% endif %}
                {% if __post_tags__ %}
                    <p class="post_tags">{% for tag in __post_tags__ %}<a href="/tags/{{ tag }}/" class="tag">#{{ tag }}</a> {% endfor %}</p>
                {% endif %}
		<div class="content">
		    {{ __content__ }}
		<div>
	    {% endif %}
            <div class="footer">
               {% if footer %}
                   <p>{{ footer }}</p>
               {% endif %}
            </div>
        </div>
    </body>

</html>
