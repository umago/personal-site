<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">

        <link rel="stylesheet" type="text/css" href="/style.css">
        {% if title %}
            <title>{{ title }} - #{{ __tag__ }}</title>
        {% endif %}
    </head>

    <body>
	<div class="wrapper">
	    <div class="header">
		<h1>{{ header }}</h1>
		<ul>
		    {% for name, href in __links__ %}
		        <li><a href="{{ href }}">{{ name }}</a></li>
		    {% endfor %}
		</ul>
	    </div>

            <p class="tag-heading">posts tagged <span class="tag">#{{ __tag__ }}</span></p>

	    <div class="posts">
                <ul>
                    {% for post in __posts__ %}
                        <li>{{ post.date.strftime('%d %B, %Y') }} - <a href="{{ post.__href__ }}">{{ post.title }}</a>
                            <p class="post_headline">{{ post.headline }}</p>
                        </li>
                    {% endfor %}
                </ul>
	    </div>

            <div class="footer">
               {% if footer %}
                   <p>{{ footer }}</p>
               {% endif %}
            </div>
        </div>
    </body>

</html>
